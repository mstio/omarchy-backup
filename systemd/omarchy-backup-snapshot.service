[Unit]
Description=omarchy-backup: automatic snapshot
ConditionPathExists=%h/.config/omarchy-backup/config.conf
# Retry only when the upload is still pending (exit 75): the backup
# destination was unavailable (e.g. a catch-up run right after boot/resume
# before a drive or network share is mounted) or the upload could not be
# verified. At most 4 attempts in 3 hours.
StartLimitIntervalSec=3h
StartLimitBurst=4

[Service]
Type=oneshot
ExecStart=@EXEC@ snapshot --auto
Restart=on-failure
RestartPreventExitStatus=1
RestartSec=15min
